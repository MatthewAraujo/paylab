    "/v1/reports/daily": {
      "get": {
        "operationId": "ReportsController_daily",
        "parameters": [
          {
            "name": "to",
            "required": true,
            "in": "query",
            "description": "Last UTC day, inclusive, YYYY-MM-DD. The range is at most 366 days.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "from",
            "required": true,
            "in": "query",
            "description": "First UTC day, inclusive, YYYY-MM-DD.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
