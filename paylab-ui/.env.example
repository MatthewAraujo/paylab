# Also read by the browser for System Health and the Benchmarks views (/v1/benchmarks/*, no credential;
# the API serves them only in development or with BENCHMARK_ENABLED=true).
NEXT_PUBLIC_PAYLAB_API_URL=http://localhost:3333

# Server-only Merchant API key used by Server Components to read financial data.
# Never prefix with NEXT_PUBLIC_. Create one with `pnpm merchant:provision "<name>"` in paylab-api.
PAYLAB_API_KEY=
