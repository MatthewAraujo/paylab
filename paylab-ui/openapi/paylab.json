  "info": {
    "title": "PayLab API",
    "description": "Payment processing and double-entry ledger lab.",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "WalletListItemResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "example": "WALLET"
          },
          "currency": {
            "type": "string",
            "example": "BRL"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "kind",
          "currency",
          "createdAt"
        ]
      },
      "WalletPageResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WalletListItemResponse"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "Pass as `cursor` to get the following page; null on the last page."
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "UnauthorizedResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "message": {
            "type": "string",
            "example": "Invalid API key"
          },
          "error": {
            "type": "string",
            "example": "Unauthorized"
          }
        },
        "required": [
          "statusCode",
          "message",
          "error"
        ]
      },
      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 422
          },
          "code": {
            "type": "string",
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "description": "Field-level details when available."
          }
        },
        "required": [
          "statusCode",
          "code",
          "message"
        ]
      },
      "AccountResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "example": "WALLET"
          },
          "currency": {
            "type": "string",
            "example": "BRL"
          }
        },
        "required": [
          "id",
          "kind",
          "currency"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "RESOURCE_NOT_FOUND"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "BalanceResponse": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "balance": {
            "type": "number",
            "description": "Credits minus debits. Integer centavos, never a decimal."
          },
          "currency": {
            "type": "string",
            "example": "BRL"
          }
        },
        "required": [
          "accountId",
          "balance",
          "currency"
        ]
      },
      "LedgerEntryResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ledgerTransactionId": {
            "type": "string",
            "format": "uuid"
          },
          "direction": {
            "type": "string",
            "enum": [
              "DEBIT",
              "CREDIT"
            ]
          },
          "amount": {
            "type": "number",
            "description": "Always positive; the sign comes from direction. Integer centavos, never a decimal."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "ledgerTransactionId",
          "direction",
          "amount",
          "createdAt"
        ]
      },
      "LedgerEntryPageResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LedgerEntryResponse"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "Pass as `cursor` to get the following page; null on the last page."
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "PaymentResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sourceAccountId": {
            "type": "string",
            "format": "uuid"
          },
          "destinationAccountId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "number",
            "description": "Integer centavos, never a decimal."
          },
          "currency": {
            "type": "string",
            "example": "BRL"
          },
          "status": {
            "type": "string",
            "enum": [
              "CREATED",
              "PROCESSING",
              "SUCCEEDED",
              "FAILED"
            ]
          },
          "failureReason": {
            "type": "string",
            "nullable": true,
            "example": "INSUFFICIENT_FUNDS"
          },
          "ledgerTransactionId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "sourceAccountId",
          "destinationAccountId",
          "amount",
          "currency",
          "status",
          "failureReason",
          "ledgerTransactionId",
          "createdAt",
          "updatedAt"
        ]
      },
      "PaymentPageResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaymentResponse"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "Pass as `cursor` to get the following page; null on the last page."
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "DailyReportRowResponse": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "example": "2026-09-01",
            "description": "UTC calendar day."
          },
          "status": {
            "type": "string",
            "enum": [
              "CREATED",
              "PROCESSING",
              "SUCCEEDED",
              "FAILED"
            ]
          },
          "count": {
            "type": "number"
          },
          "volume": {
            "type": "number",
            "description": "Sum of the Payments' amounts. Integer centavos, never a decimal."
          }
        },
        "required": [
          "date",
          "status",
          "count",
          "volume"
        ]
      },
      "DailyReportResponse": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "example": "2026-09-01"
          },
          "to": {
            "type": "string",
            "example": "2026-09-30"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DailyReportRowResponse"
            }
          }
        },
        "required": [
          "from",
          "to",
          "items"
        ]
      }
    }
  }
}
