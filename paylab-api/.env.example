APP_NAME=quintal-agro-pet
NODE_ENV=development
PORT=3333
LOG_ENABLED=false
LOG_LEVEL=basic
DATABASE_URL=postgresql://docker:docker@localhost:5432/quintal_agro_pet?schema=public

# Better Auth Configuration
BETTER_AUTH_SECRET=replace-with-32-char-min-random-secret
# Public auth URL seen by the browser. If the frontend proxies `/api/auth` in
# local development, use the frontend origin here instead of the API port.
BETTER_AUTH_URL=http://localhost:3333
FRONTEND_URL=http://localhost:3000
# Optional. Leave empty in local dev. In production, set to the shared parent
# domain (e.g. ".quintal-agropet.com") so the session cookie set by this API
# (e.g. on api.quintal-agropet.com) is also sent by the browser to the
# Vercel-hosted frontend (quintal-agropet.com). Must start with a dot.
COOKIE_DOMAIN=
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM="Your Name <you@example.com>"
# Set to "true" to skip real email sends (logs the verification/reset URL
# instead) — handy while testing sign-up/reset flows locally.
DISABLE_TRANSACTIONAL_EMAILS=false

# Optional: only set these to enable Google OAuth. Left empty, the provider
# stays inactive (no boot error).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional explicit callback URL override for Google. Useful when the browser
# reaches Better Auth through a frontend proxy such as
# `http://localhost:3000/api/auth/callback/google`.
GOOGLE_REDIRECT_URI=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
CLOUDFLARE_ACCOUNT_ID=
# Public base URL for the R2 bucket (Cloudflare R2 Custom Domain). Attachment
# URLs are built as `${R2_PUBLIC_URL}/${objectKey}`.
R2_PUBLIC_URL=
# Set to "true" to skip real R2 uploads (logs the object key instead) —
# handy while testing locally without valid R2 credentials.
DISABLE_R2_UPLOADS=false

# Distance-based delivery fee (ADR 0007 / ADR 0012). A CEP is resolved to
# coordinates by AwesomeAPI first (street-level lat/lng; also settles whether
# the CEP exists), falling back to ViaCEP for the address and Nominatim to
# geocode it. AWESOME_API_TOKEN is optional (sent as X-Api-Key when set).
# NOMINATIM_CONTACT is sent in the User-Agent per Nominatim's usage policy.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_CONTACT=
AWESOME_API_BASE_URL=https://cep.awesomeapi.com.br/json
AWESOME_API_TOKEN=
VIACEP_BASE_URL=https://viacep.com.br/ws
