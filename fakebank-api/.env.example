APP_NAME=fakebank-api
NODE_ENV=development
PORT=4000
LOG_ENABLED=false
LOG_LEVEL=basic
# FakeBank owns its own database; never point this at PayLab's.
DATABASE_URL=postgresql://fakebank:fakebank@localhost:5434/fakebank?schema=public
# Clients as comma-separated clientId:sha256-hex-of-key (never the key itself).
# Development only: the key below is public and fake. Use it as
#   Authorization: Bearer fakebank-dev-key-paylab-not-a-secret
# For any other environment generate a random key and hash it with `pnpm client-key:hash`.
FAKEBANK_CLIENTS=paylab:5489e8238a869fd3a7d6c634818fca30656b25435dd903860d123236437a576a
