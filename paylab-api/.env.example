APP_NAME=paylab-api
NODE_ENV=development
PORT=3333
LOG_ENABLED=false
LOG_LEVEL=basic
DATABASE_URL=postgresql://paylab:paylab@localhost:5432/paylab?schema=public

# Browser origin(s) allowed by CORS, comma-separated. Optional outside production.
FRONTEND_URL=http://localhost:3000

# Separate benchmark database (T12); the name must contain "bench". See docs/benchmark.md.
BENCH_DATABASE_URL=postgresql://paylab:paylab@localhost:5433/paylab_bench?schema=public
