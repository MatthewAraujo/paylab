            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "Payments"
        ]
      },
      "get": {
        "operationId": "PaymentsController_list",
        "parameters": [
          {
            "name": "to",
            "required": false,
            "in": "query",
            "description": "Exclusive. Same format as `from`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "required": false,
            "in": "query",
            "description": "Inclusive. ISO 8601 timestamp with a zone, or a YYYY-MM-DD day (00:00 UTC).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "CREATED",
                "PROCESSING",
                "SUCCEEDED",
                "FAILED"
              ],
              "type": "string"
            }
          },
          {
            "name": "accountId",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
