{
  "name": "fakebank-api",
  "version": "0.0.1",
  "description": "FakeBank, a fictional external payment provider used as an adversarial test environment for PayLab",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "postinstall": "prisma generate",
    "start": "nest start",
    "start:prod": "node dist/infra/main",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe",
    "test": "vitest run",
    "test:integration": "vitest run --config ./vitest.config.integration.ts",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:concurrency": "vitest run --config ./vitest.config.concurrency.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/swagger": "^11.4.5",
    "@prisma/client": "^6.9.0",
    "dotenv": "^16.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.61"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.3",
    "@swc/core": "^1.12.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.9.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.1",
    "testcontainers": "^12.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "unplugin-swc": "^1.5.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.3"
  }
}
