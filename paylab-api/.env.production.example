# Production reference for petagro-api.
# Copy these into your hosting provider's env var UI (e.g. Railway) with the
# real values filled in. Never commit an .env file with actual secrets.

APP_NAME=quintal-agro-pet
NODE_ENV=production
PORT=3333
LOG_ENABLED=true
LOG_LEVEL=basic

# Managed Postgres connection string from your hosting provider (e.g.
# Railway's Postgres plugin). Do NOT reuse the local docker-compose
# credentials. Add ?sslmode=require if your provider needs it for external
# connections (usually not needed for Railway's internal DATABASE_URL).
DATABASE_URL=postgresql://postgres:replace-me@postgres.railway.internal:5432/railway

# Better Auth Configuration
# Generate a NEW secret for production, do not reuse the local dev one:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-new-secret
# This API's real deployed origin, no trailing slash.
BETTER_AUTH_URL=https://api.quintal-agropet.com
# The frontend's real deployed origin. Must be byte-for-byte identical to the
# frontend's own FRONTEND_URL — used as the Origin header on Better Auth's
# CSRF check for cookie-authenticated mutations, and for CORS (HTTP + PDV
# WebSocket).
FRONTEND_URL=https://quintal-agropet.com

# Required here because frontend and API now live on sibling subdomains of
# the same parent domain, and the PDV Socket.IO connection authenticates
# directly against the API host from the browser.
COOKIE_DOMAIN=.quintal-agropet.com

RESEND_API_KEY=replace-me
EMAIL_FROM="Contato Quintal Agropet <contato@quintal-agropet.com>"
DISABLE_TRANSACTIONAL_EMAILS=false

# Optional: only set these to enable Google OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional explicit callback URL override when Google must redirect somewhere
# other than `${BETTER_AUTH_URL}/api/auth/callback/google`.
GOOGLE_REDIRECT_URI=


AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_BUCKET_NAME=petagro-uploads
CLOUDFLARE_ACCOUNT_ID=replace-me
# Public base URL for the R2 bucket (Cloudflare R2 Custom Domain). Must match
# the host allowed in petagro's next.config.ts images.remotePatterns.
R2_PUBLIC_URL=https://cdn.quintal-agropet.com
DISABLE_R2_UPLOADS=false

# Distance-based delivery fee (ADR 0007). CEP -> coordinates via BrasilAPI,
# then ViaCEP + Nominatim as fallbacks. Set NOMINATIM_CONTACT to a real
# contact address — Nominatim's usage policy requires it for the public
# instance, and heavy use without it can be blocked.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_CONTACT=ops@quintal-agropet.com
BRASIL_API_BASE_URL=https://brasilapi.com.br/api
VIACEP_BASE_URL=https://viacep.com.br/ws
