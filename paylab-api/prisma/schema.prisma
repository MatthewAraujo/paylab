generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StoreMembershipRole {
  OWNER
  ADMIN
}

enum CatalogProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CatalogCategoryStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CatalogBrandStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CatalogVariantStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum InventoryMovementType {
  INBOUND
  OUTBOUND
  ADJUSTMENT
  RETURN
}

enum OrderStatus {
  PROCESSING
  READY_FOR_PICKUP
  SHIPPED
  DELIVERED
  CANCELLED
}

enum OrderPaymentMethod {
  PIX
  CREDIT_CARD
  CASH
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PromotionVisibility {
  PUBLIC
  PRIVATE
}

enum PromotionChannel {
  ECOMMERCE
  PDV
}

enum PromotionTargetScope {
  ELIGIBLE_ITEMS
  ORDER_SUBTOTAL
  SHIPPING
}

enum PdvSessionStatus {
  OPEN
  CLOSED
}

enum SaleDraftStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum AuditActorType {
  USER
  SYSTEM
}

enum AuditEntityType {
  STORE
  USER
  STORE_MEMBERSHIP
  AUTH
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships StoreMembership[]
  auditLogs   AuditLog[]

  @@map("users")
}

model Store {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  timezone  String   @default("America/Sao_Paulo")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships                     StoreMembership[]
  membersV2                       StoreMember[]                   @relation("StoreMembersV2")
  auditLogs                       AuditLog[]
  brands                          Brand[]
  categories                      Category[]
  products                        Product[]
  productVariants                 ProductVariant[]
  productCategories               ProductCategory[]
  productImages                   ProductImage[]
  attachments                     Attachment[]
  inventoryItems                  InventoryItem[]
  inventoryMovements              InventoryMovement[]
  merchandisingFeaturedCategories MerchandisingFeaturedCategory[]
  merchandisingFeaturedProducts   MerchandisingFeaturedProduct[]
  storeCustomers                  StoreCustomer[]
  orders                          Order[]
  promotions                      Promotion[]
  curatedHomeOffers               CuratedHomeOffer[]
  storeMemberProvisioningLogs     StoreMemberProvisioningLog[]
  pdvSessions                     PdvSession[]
  shippingSettings                StoreShippingSettings?

  @@map("stores")
}

model StoreMembership {
  id        String              @id @default(uuid())
  userId    String              @unique @map("user_id")
  storeId   String              @unique @map("store_id")
  role      StoreMembershipRole @default(ADMIN)
  createdAt DateTime            @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@map("store_memberships")
}

model Brand {
  id               String             @id @default(uuid())
  storeId          String             @map("store_id")
  name             String
  slug             String
  status           CatalogBrandStatus @default(ACTIVE)
  logoAttachmentId String?            @map("logo_attachment_id")
  logoUrl          String?            @map("logo_url")
  archivedAt       DateTime?          @map("archived_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  store          Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  logoAttachment Attachment? @relation("BrandLogoAttachment", fields: [logoAttachmentId], references: [id], onDelete: SetNull)
  products       Product[]

  @@unique([storeId, slug])
  @@index([storeId, status, name])
  @@index([logoAttachmentId])
  @@map("brands")
}

model Category {
  id                String                @id @default(uuid())
  storeId           String                @map("store_id")
  parentCategoryId  String?               @map("parent_category_id")
  name              String
  slug              String
  status            CatalogCategoryStatus @default(ACTIVE)
  imageAttachmentId String?               @map("image_attachment_id")
  imageUrl          String?               @map("image_url")
  isVisibleOnHome   Boolean               @default(false) @map("is_visible_on_home")
  archivedAt        DateTime?             @map("archived_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  store                 Store                           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parentCategory        Category?                       @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  childCategories       Category[]                      @relation("CategoryHierarchy")
  imageAttachment       Attachment?                     @relation("CategoryImageAttachment", fields: [imageAttachmentId], references: [id], onDelete: SetNull)
  primaryForProducts    Product[]                       @relation("PrimaryProductCategory")
  productAssignments    ProductCategory[]
  merchandisingFeatured MerchandisingFeaturedCategory[]

  @@unique([storeId, slug])
  @@index([storeId, parentCategoryId, status])
  @@index([imageAttachmentId])
  @@map("categories")
}

model Product {
  id                String               @id @default(uuid())
  storeId           String               @map("store_id")
  brandId           String?              @map("brand_id")
  primaryCategoryId String?              @map("primary_category_id")
  name              String
  slug              String
  description       String?
  status            CatalogProductStatus @default(DRAFT)
  publishedAt       DateTime?            @map("published_at")
  deactivatedAt     DateTime?            @map("deactivated_at")
  archivedAt        DateTime?            @map("archived_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  store                 Store                          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  brand                 Brand?                         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  primaryCategory       Category?                      @relation("PrimaryProductCategory", fields: [primaryCategoryId], references: [id], onDelete: SetNull)
  variants              ProductVariant[]
  categories            ProductCategory[]
  images                ProductImage[]
  merchandisingFeatured MerchandisingFeaturedProduct[]
  favorites             CustomerFavorite[]

  @@unique([storeId, slug])
  @@index([storeId, status, name])
  @@index([brandId])
  @@index([primaryCategoryId])
  @@map("products")
}

model ProductVariant {
  id            String               @id @default(uuid())
  storeId       String               @map("store_id")
  productId     String               @map("product_id")
  name          String
  sku           String
  barcode       String?              @map("barcode")
  status        CatalogVariantStatus @default(ACTIVE)
  priceCents    Int                  @map("price_cents")
  costCents     Int?                 @map("cost_cents")
  attributes    Json                 @default("{}")
  deactivatedAt DateTime?            @map("deactivated_at")
  archivedAt    DateTime?            @map("archived_at")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItem      InventoryItem?
  inventoryMovements InventoryMovement[]
  saleDraftItems     SaleDraftItem[]

  @@unique([storeId, sku])
  @@unique([storeId, barcode])
  @@index([productId, status])
  @@index([storeId, status])
  @@map("product_variants")
}

model ProductCategory {
  id         String   @id @default(uuid())
  storeId    String   @map("store_id")
  productId  String   @map("product_id")
  categoryId String   @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([storeId, categoryId])
  @@map("product_categories")
}

model ProductImage {
  id           String   @id @default(uuid())
  storeId      String   @map("store_id")
  productId    String   @map("product_id")
  attachmentId String   @map("attachment_id")
  url          String
  altText      String?  @map("alt_text")
  position     Int
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  store      Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Restrict)

  @@index([productId, position])
  @@index([storeId, productId])
  @@index([attachmentId])
  @@map("product_images")
}

model Attachment {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  title     String
  url       String
  createdAt DateTime @default(now()) @map("created_at")

  store               Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  brandLogoUsages     Brand[]        @relation("BrandLogoAttachment")
  categoryImageUsages Category[]     @relation("CategoryImageAttachment")
  productImageUsages  ProductImage[]

  @@index([storeId, createdAt])
  @@map("attachments")
}

model InventoryItem {
  id                String   @id @default(uuid())
  storeId           String   @map("store_id")
  variantId         String   @unique @map("variant_id")
  availableQuantity Int      @default(0) @map("available_quantity")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  store     Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]

  @@unique([storeId, variantId])
  @@index([storeId, availableQuantity])
  @@map("inventory_items")
}

model InventoryMovement {
  id              String                @id @default(uuid())
  storeId         String                @map("store_id")
  inventoryItemId String                @map("inventory_item_id")
  variantId       String                @map("variant_id")
  type            InventoryMovementType
  quantityDelta   Int                   @map("quantity_delta")
  balanceAfter    Int                   @map("balance_after")
  note            String?
  createdAt       DateTime              @default(now()) @map("created_at")

  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId, createdAt])
  @@index([storeId, variantId, createdAt])
  @@map("inventory_movements")
}

model MerchandisingFeaturedCategory {
  id         String   @id @default(uuid())
  storeId    String   @map("store_id")
  categoryId String   @map("category_id")
  position   Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([storeId, categoryId])
  @@unique([storeId, position])
  @@index([storeId, position])
  @@map("merchandising_featured_categories")
}

model MerchandisingFeaturedProduct {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  productId String   @map("product_id")
  position  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
  @@unique([storeId, position])
  @@index([storeId, position])
  @@map("merchandising_featured_products")
}

model AuditLog {
  id          String          @id @default(uuid())
  storeId     String?         @map("store_id")
  actorType   AuditActorType  @map("actor_type")
  actorUserId String?         @map("actor_user_id")
  action      String
  entityType  AuditEntityType @map("entity_type")
  entityId    String          @map("entity_id")
  metadata    Json?
  occurredAt  DateTime        @default(now()) @map("occurred_at")

  store     Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)
  actorUser User?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([storeId, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@map("audit_logs")
}

// Better Auth Integration Models
// These models link to Better Auth's user table via userId (string)

model CustomerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships to PetAgro domain (optional for future)
  // orders Order[]

  @@index([userId])
  @@map("customer_profiles")
}

model StoreMember {
  id        String              @id @default(uuid())
  userId    String              @map("user_id")
  storeId   String              @map("store_id")
  role      StoreMembershipRole @default(ADMIN)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  store Store @relation("StoreMembersV2", fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([storeId])
  @@map("store_members")
}

model PlatformAdmin {
  userId    String   @id @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("platform_admins")
}

model StoreMemberProvisioningLog {
  id              String   @id @default(uuid())
  storeId         String   @map("store_id")
  createdUserId   String   @map("created_user_id")
  createdEmail    String   @map("created_email")
  createdByUserId String   @map("created_by_user_id")
  createdByEmail  String   @map("created_by_email")
  createdAt       DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@map("store_member_provisioning_logs")
}

// Keep existing StoreMembership for backward compatibility during migration
// This will be removed in Task #12 when JWT auth is fully removed

enum StoreCustomerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CustomerSegment {
  NEW
  REGULAR
  VIP
  AT_RISK
  DORMANT
}

enum CRMInteractionType {
  NOTE
  EMAIL
  PHONE_CALL
  CHAT
  SUPPORT_TICKET
}

enum CRMInteractionChannel {
  EMAIL
  PHONE
  WHATSAPP
  IN_PERSON
  SYSTEM
}

model StoreCustomer {
  id                String @id @default(uuid())
  storeId           String @map("store_id")
  customerProfileId String @map("customer_profile_id")

  name  String?
  email String
  phone String?

  status StoreCustomerStatus @default(ACTIVE)

  totalOrders     Int       @default(0) @map("total_orders")
  totalSpentCents Int       @default(0) @map("total_spent_cents")
  lastOrderAt     DateTime? @map("last_order_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store      Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  addresses  StoreCustomerAddress[]
  crmProfile CRMProfile?
  orders     Order[]
  favorites  CustomerFavorite[]

  @@unique([storeId, customerProfileId])
  @@index([storeId, status])
  @@map("store_customers")
}

model StoreCustomerAddress {
  id              String @id @default(uuid())
  storeCustomerId String @map("store_customer_id")

  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  postalCode   String  @map("postal_code")

  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  storeCustomer StoreCustomer @relation(fields: [storeCustomerId], references: [id], onDelete: Cascade)

  @@index([storeCustomerId])
  @@map("store_customer_addresses")
}

model CustomerFavorite {
  id              String   @id @default(uuid())
  storeCustomerId String   @map("store_customer_id")
  productId       String   @map("product_id")
  createdAt       DateTime @default(now()) @map("created_at")

  storeCustomer StoreCustomer @relation(fields: [storeCustomerId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeCustomerId, productId])
  @@index([productId])
  @@map("customer_favorites")
}

model CRMProfile {
  id              String @id @default(uuid())
  storeCustomerId String @unique @map("store_customer_id")

  segment CustomerSegment @default(NEW)
  tags    String[]

  notes         String?
  lastContactAt DateTime? @map("last_contact_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  storeCustomer StoreCustomer    @relation(fields: [storeCustomerId], references: [id], onDelete: Cascade)
  interactions  CRMInteraction[]

  @@map("crm_profiles")
}

model CRMInteraction {
  id           String @id @default(uuid())
  crmProfileId String @map("crm_profile_id")

  type    CRMInteractionType
  channel CRMInteractionChannel
  subject String?
  content String?

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  crmProfile CRMProfile @relation(fields: [crmProfileId], references: [id], onDelete: Cascade)

  @@index([crmProfileId, createdAt])
  @@map("crm_interactions")
}

model Order {
  id              String  @id @default(uuid())
  storeId         String  @map("store_id")
  // Exactly one of storeCustomerId or (guestName + guestPhone) is set —
  // enforced by the domain's Order.create(), not a DB constraint. A guest
  // order is a walk-in sale for a customer with no registered account.
  storeCustomerId String? @map("store_customer_id")
  guestName       String? @map("guest_name")
  guestPhone      String? @map("guest_phone")

  orderCode String @unique @map("order_code")

  status OrderStatus @default(PROCESSING)

  // Final charged snapshot — kept exactly as before.
  subtotalCents Int @map("subtotal_cents")
  shippingCents Int @map("shipping_cents")
  totalCents    Int @map("total_cents")

  // Promotions commercial snapshot (ADR 0011). These describe how the final
  // charged values above were reached; they never replace subtotalCents /
  // shippingCents. A no-promotion order has base == final and every discount 0.
  baseSubtotalCents      Int  @default(0) @map("base_subtotal_cents")
  itemDiscountTotalCents Int  @default(0) @map("item_discount_total_cents")
  shippingBaseCents      Int  @default(0) @map("shipping_base_cents")
  shippingDiscountCents  Int  @default(0) @map("shipping_discount_cents")
  totalDiscountCents     Int  @default(0) @map("total_discount_cents")
  appliedPromotions      Json @default("[]") @map("applied_promotions")

  shippingAddress Json   @map("shipping_address")
  deliveryLabel   String @map("delivery_label")

  paymentMethod OrderPaymentMethod @map("payment_method")

  cancelledAt DateTime? @map("cancelled_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeCustomer StoreCustomer? @relation(fields: [storeCustomerId], references: [id], onDelete: Restrict)
  items         OrderItem[]

  @@index([storeId, status, createdAt])
  @@index([storeCustomerId, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String @map("order_id")
  productId String @map("product_id")
  variantId String @map("variant_id")

  productName  String @map("product_name")
  variantLabel String @map("variant_label")
  sku          String

  unitPriceCents Int @map("unit_price_cents")
  quantity       Int
  lineTotalCents Int @map("line_total_cents")

  // Per-line promotion allocation (ADR 0011). base* fields are the pre-discount
  // catalog values; discount fields default to 0 for a no-promotion line.
  baseUnitPriceCents Int @default(0) @map("base_unit_price_cents")
  unitDiscountCents  Int @default(0) @map("unit_discount_cents")
  baseLineTotalCents Int @default(0) @map("base_line_total_cents")
  lineDiscountCents  Int @default(0) @map("line_discount_cents")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

// PDV (point of sale): a StoreMember opens a PdvSession for their store,
// which starts an in-progress SaleDraft. See docs/PRD-PDV.md and ADR
// 0003-0005 for the full reasoning. At most one OPEN PdvSession per store,
// and at most one OPEN SaleDraft per session, both enforced by a partial
// unique index added via raw SQL in this migration (see migration.sql) since
// Prisma cannot express a partial unique constraint natively.
model PdvSession {
  id             String           @id @default(uuid())
  storeId        String           @map("store_id")
  // Not a Prisma relation: the real Better Auth `user` table lives outside
  // Prisma's schema (see StoreMember.userId for the same convention).
  openedByUserId String           @map("opened_by_user_id")
  status         PdvSessionStatus @default(OPEN)
  openedAt       DateTime         @default(now()) @map("opened_at")
  closedAt       DateTime?        @map("closed_at")

  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  saleDrafts SaleDraft[]

  @@index([storeId, status])
  @@map("pdv_sessions")
}

model SaleDraft {
  id                String          @id @default(uuid())
  pdvSessionId      String          @map("pdv_session_id")
  status            SaleDraftStatus @default(OPEN)
  // Barcodes scanned during this draft that matched no ProductVariant.barcode
  // at scan time. Recorded here so the operator can resolve them after
  // checkout (see ResolveUnmatchedBarcodeUseCase / T8) instead of losing them.
  unmatchedBarcodes Json            @default("[]") @map("unmatched_barcodes")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  pdvSession PdvSession      @relation(fields: [pdvSessionId], references: [id], onDelete: Cascade)
  items      SaleDraftItem[]

  @@index([pdvSessionId, status])
  @@map("sale_drafts")
}

model SaleDraftItem {
  id          String @id @default(uuid())
  saleDraftId String @map("sale_draft_id")
  variantId   String @map("variant_id")
  // No price/name snapshot on purpose (ADR 0003) — always read live from the
  // catalog on display/broadcast.
  quantity    Int

  saleDraft SaleDraft      @relation(fields: [saleDraftId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([saleDraftId, variantId])
  @@index([saleDraftId])
  @@map("sale_draft_items")
}

// Per-store configuration for distance-priced local delivery (ADR 0007).
// 1:1 with Store — the absence of this row means "shipping not configured",
// and the storefront then offers store pickup only.
model StoreShippingSettings {
  id                     String   @id @default(uuid())
  storeId                String   @unique @map("store_id")
  // Store origin CEP, normalized to 8 digits (no dash).
  originPostalCode       String   @map("origin_postal_code")
  baseCents              Int      @map("base_cents")
  perKmCents             Int      @map("per_km_cents")
  maxDistanceKm          Int      @map("max_distance_km")
  // Deliveries within this many km cost nothing (base + per-km both waived).
  // 0 disables free shipping entirely. Must not exceed maxDistanceKm.
  freeShippingDistanceKm Int      @default(0) @map("free_shipping_distance_km")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_shipping_settings")
}

// Persistent geocode cache: a CEP coordinate is global (not store-scoped) and
// stable, so there is no TTL in v1. Populated on demand by the CEP distance
// service. `provider` records which upstream resolved the coordinate
// (`awesomeapi` by default, `nominatim` for the address fallback) — ADR 0012.
model CepGeocode {
  id         String   @id @default(uuid())
  postalCode String   @unique @map("postal_code")
  latitude   Float
  longitude  Float
  provider   String   @default("awesomeapi")
  resolvedAt DateTime @default(now()) @map("resolved_at")

  @@map("cep_geocodes")
}

// Store-scoped commercial campaign (ADR 0011 / CONTEXT "Promotion"). Promotions
// never rewrite the catalog's base variant price — they are evaluated against a
// checkout/PDV pricing context and snapshotted onto the resulting order.
// `conditions` and `benefits` are JSON arrays of typed payloads validated at the
// domain boundary in later tasks; the MVP condition set is product, category
// subtree, minimum eligible quantity, minimum gross cart value, coupon, channel,
// and delivery method, and the MVP benefit set is percentage, fixed amount,
// BUY_X_PAY_Y, and promotional free shipping. `publicHighlight` is the optional
// storefront-safe discovery payload (badge copy, projected pack pricing).
model Promotion {
  id              String               @id @default(uuid())
  storeId         String               @map("store_id")
  name            String
  status          PromotionStatus      @default(DRAFT)
  visibility      PromotionVisibility  @default(PRIVATE)
  channels        PromotionChannel[]
  priority        Int                  @default(0)
  isStackable     Boolean              @default(false) @map("is_stackable")
  targetScope     PromotionTargetScope @map("target_scope")
  startsAt        DateTime?            @map("starts_at")
  endsAt          DateTime?            @map("ends_at")
  conditions      Json                 @default("[]")
  benefits        Json                 @default("[]")
  publicHighlight Json?                @map("public_highlight")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  curatedHomeOffer CuratedHomeOffer?

  // Composite unique so CuratedHomeOffer can carry a store-scoped FK that
  // guarantees a curated offer only ever references a promotion from the same
  // store.
  @@unique([id, storeId])
  @@index([storeId, status, visibility])
  @@index([storeId, priority, createdAt])
  @@index([storeId, startsAt, endsAt])
  @@map("promotions")
}

// One curated storefront home "ofertas" slot (CONTEXT "Curated Home Offer").
// The home lane is operator-curated, not an automatic dump of every active
// public promotion — same spirit as merchandising featured lists.
model CuratedHomeOffer {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  promotionId String   @map("promotion_id")
  position    Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId, storeId], references: [id, storeId], onDelete: Cascade)

  @@unique([promotionId, storeId])
  @@unique([storeId, position])
  @@index([storeId, position])
  @@map("curated_home_offers")
}
