-- Write-cost workload (experiment only): the same inserts as settle.pgbench without the lock and
-- the Balance read, so index maintenance and trigger cost are what is measured.
\set s random_zipfian(1, 1000, 1.15)
\set d random_zipfian(1, 1000, 1.15)
BEGIN;
SELECT id AS sid, merchant_id AS mid FROM bw WHERE n = :s \gset
SELECT id AS did FROM bw WHERE n = :d \gset
SELECT gen_random_uuid() AS txid, gen_random_uuid() AS pid \gset
INSERT INTO ledger_transactions (id) VALUES (':txid');
INSERT INTO ledger_entries (ledger_transaction_id, account_id, direction, amount) VALUES (':txid', ':sid', 'DEBIT', 100), (':txid', ':did', 'CREDIT', 100);
INSERT INTO payments (id, merchant_id, source_account_id, destination_account_id, amount, currency, status, idempotency_key, request_fingerprint) VALUES (':pid', ':mid', ':sid', ':did', 100, 'BRL', 'CREATED', ':txid', 'fp');
UPDATE payments SET status = 'SUCCEEDED', ledger_transaction_id = ':txid', updated_at = now() WHERE id = ':pid';
COMMIT;
