APP_NAME=paylab-api
NODE_ENV=development
PORT=3333
LOG_ENABLED=false
LOG_LEVEL=basic
DATABASE_URL=postgresql://paylab:paylab@localhost:5432/paylab?schema=public

# Browser origin(s) allowed by CORS, comma-separated. Optional outside production.
FRONTEND_URL=http://localhost:3000

# Separate benchmark database (T12); the name must contain "bench". See docs/benchmark.md.
BENCH_DATABASE_URL=postgresql://paylab:paylab@localhost:5433/paylab_bench?schema=public

# Separate demo database for `pnpm demo:seed` (T18). Must be local and its name must contain "demo".
DEMO_DATABASE_URL=postgresql://paylab:paylab@localhost:5432/paylab_demo?schema=public

# Optional locations for `pnpm benchmark:run`. Artifacts (logs, running state) stay local and
# ignored by Git; normalized Summaries are versioned and committed manually after review.
# BENCH_ARTIFACT_ROOT=.benchmark
# BENCH_SUMMARY_DIR=bench/results
# BENCH_BASELINE_FILE=bench/baseline.json

# Benchmark read API (`/v1/benchmarks/*`): a local developer surface that serves benchmark logs and
# Summaries. On by default only when NODE_ENV=development; the API refuses to start with it
# enabled in production. Reads BENCH_SUMMARY_DIR and BENCH_ARTIFACT_ROOT (above); needs no database.
# BENCHMARK_ENABLED=true
